# ═══════════════════════════════════════════════════════════════
# AAU Registration System — Backend Environment Variables
# Copy this file as .env and fill in the values
# ═══════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/aau_registration?schema=public

# ── Authentication (JWT) ──────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-minimum-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend URL (CORS origin, comma-separated for multiple) ─
FRONTEND_URL=https://your-domain.com

# ── Chapa Payment Gateway ─────────────────────────────────────
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxx
CHAPA_ENCRYPTION_KEY=
CHAPA_WEBHOOK_SECRET=

# ── Redis (Optional — for job queues) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="AAU Registration <noreply@aau.edu.et>"

# ── AWS S3 (Optional — for cloud document storage) ────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
